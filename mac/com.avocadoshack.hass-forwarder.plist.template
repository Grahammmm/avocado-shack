<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.avocadoshack.hass-forwarder</string>
  <key>ProgramArguments</key><array>
    <string>@PYTHON@</string><string>-B</string>
    <string>@REPO@/mac/hass_forwarder.py</string><string>serve</string>
    <string>--config</string><string>@CONFIG@</string>
  </array>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>Umask</key><integer>63</integer>
  <key>ProcessType</key><string>Standard</string>
  <key>StandardOutPath</key><string>@LOGDIR@/forwarder.log</string>
  <key>StandardErrorPath</key><string>@LOGDIR@/forwarder-error.log</string>
</dict></plist>
