[Unit]
Description=Hass receiver: sealed inbound and reply relay (HASS-RCV-1)
After=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/.local/share/hass/runtime
ExecStart=/usr/bin/python3 -B %h/.local/share/hass/runtime/hass/host.py serve --host %h/.local/state/hass/host/host.json
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
