[Unit]
Description=Hass cache-only stock and till-versus-site reports (template, not installed by default)

[Service]
Type=oneshot
WorkingDirectory=%h/.local/share/hass/runtime
ExecStart=/usr/bin/python3 -B %h/.local/share/hass/runtime/hass/clover/cli.py report --all --host %h/.local/state/hass/host/host.json
TimeoutStartSec=60
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
