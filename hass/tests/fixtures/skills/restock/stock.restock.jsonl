{"id": "x14-refuse-clear-nothing-set", "kind": "refuse", "version": 3, "note": "clearing a product with no restock day changes nothing", "texts": ["never mind about the lemons restock"], "replies": [{"skill": "stock.restock", "slots": {"item": "photo-product-017", "clear": true}}], "expect": {"skill": "stock.restock", "disposition": "unsupported", "reply_contains": "no restock day to clear"}}
{"id": "x15-refuse-same-day-again", "kind": "refuse", "version": 3, "note": "the day is already set: nothing to change", "texts": ["more honey coming Thursday"], "replies": [{"skill": "stock.restock", "slots": {"item": "photo-product-042", "day": "2026-11-12"}}], "expect": {"skill": "stock.restock", "disposition": "unsupported", "reply_contains": "Nothing to change"}, "setup": [{"op": "product.set_restock", "args": {"id": "photo-product-042", "restock_on": "2026-11-12"}}]}
