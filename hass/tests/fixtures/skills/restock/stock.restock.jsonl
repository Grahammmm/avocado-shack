{"id": "s09-clean-eggs-in-2-weeks", "kind": "clean", "version": 3, "note": "spec 3.8 sentence 9: 'in 2 weeks' from Sunday 2026-11-08 is 2026-11-22, shown before the yes", "texts": ["eggs back in 2 weeks"], "replies": [{"skill": "stock.restock", "slots": {"item": "photo-product-024", "day": "2026-11-22"}}], "expect": {"skill": "stock.restock", "disposition": "proposed", "ops": [{"op": "product.set_restock", "args": {"id": "photo-product-024", "restock_on": "2026-11-22"}}], "diff": [{"file": "hass/content/products.json", "path": "products[photo-product-024].restock_on", "after": "2026-11-22"}], "files": ["hass/content/products.json"], "preview": {"kind": "none"}, "reply_contains": "Cal Poly eggs: more expected Sun Nov 22"}}
{"id": "s10-refuse-quantity-asks-day", "kind": "refuse", "version": 3, "note": "spec 3.8 sentence 10: a quantity is never stored; the one question carries the counts sentence", "texts": ["restock 40 jars of honey"], "replies": [{"skill": "stock.restock", "slots": {"item": "photo-product-042"}}], "expect": {"skill": "stock.restock", "disposition": "unsupported", "reply_contains": "I don't keep counts yet. What day is more coming?"}}
{"id": "x11-refuse-quantity-with-day", "kind": "refuse", "version": 3, "note": "a complete request with a quantity writes nothing, not even the date", "texts": ["restock 40 jars of honey on Thursday"], "replies": [{"skill": "stock.restock", "slots": {"item": "photo-product-042", "day": "2026-11-12"}}], "expect": {"skill": "stock.restock", "disposition": "unsupported", "reply_contains": "I don't keep counts yet. Tell me the product and day without a count."}}
{"id": "x12-refuse-more-than-60-days", "kind": "refuse", "version": 3, "note": "2026-11-08 plus 60 days is 2027-01-07; 2027-01-20 is refused", "texts": ["more honey on January 20"], "replies": [{"skill": "stock.restock", "slots": {"item": "photo-product-042", "day": "2027-01-20"}}], "expect": {"skill": "stock.restock", "disposition": "unsupported", "reply_contains": "up to 60 days ahead"}}
