{"id": "s06-vague-bread-truck", "kind": "vague", "version": 3, "note": "spec 3.8 sentence 6: four breads, so the product is asked; nothing is written", "texts": ["the bread truck comes Monday"], "replies": [{"question": "Which product?"}], "expect": {"disposition": "question", "question_contains": "Which product?"}}
{"id": "s07-refuse-past-tuesday", "kind": "refuse", "version": 3, "note": "spec 3.8 sentence 7: last Tuesday (2026-11-03) is past: refused, nothing written", "texts": ["more honey last Tuesday"], "replies": [{"skill": "stock.restock", "slots": {"item": "photo-product-042", "day": "2026-11-03"}}], "expect": {"skill": "stock.restock", "disposition": "unsupported", "reply_contains": "has already passed"}}
