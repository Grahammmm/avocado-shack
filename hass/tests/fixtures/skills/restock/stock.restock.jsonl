{"id": "s01-clean-honey-thursday", "kind": "clean", "version": 3, "note": "spec 3.8 sentence 1 (kit day is Sunday 2026-11-08, so Thursday is 2026-11-12); approved, then undone", "texts": ["more honey coming Thursday"], "replies": [{"skill": "stock.restock", "slots": {"item": "photo-product-042", "day": "2026-11-12"}}], "expect": {"skill": "stock.restock", "disposition": "proposed", "ops": [{"op": "product.set_restock", "args": {"id": "photo-product-042", "restock_on": "2026-11-12"}}], "diff": [{"file": "hass/content/products.json", "path": "products[photo-product-042].restock_on", "after": "2026-11-12"}], "files": ["hass/content/products.json"], "preview": {"kind": "none"}, "reply_contains": "Big Sur Honey Company honey: more expected Thu Nov 12"}, "undo": true}
{"id": "s02-typo-eggs-friday", "kind": "typo", "version": 3, "note": "spec 3.8 sentence 2: the recorded interpreter reply carries the corrected day (Friday); no resolver spelling claim", "texts": ["egs back on firday"], "replies": [{"skill": "stock.restock", "slots": {"item": "photo-product-024", "day": "2026-11-13"}}], "expect": {"skill": "stock.restock", "disposition": "proposed", "ops": [{"op": "product.set_restock", "args": {"id": "photo-product-024", "restock_on": "2026-11-13"}}], "diff": [{"file": "hass/content/products.json", "path": "products[photo-product-024].restock_on", "after": "2026-11-13"}], "files": ["hass/content/products.json"], "preview": {"kind": "none"}, "reply_contains": "Cal Poly eggs: more expected Fri Nov 13"}}
{"id": "s03-clean-lemons-the-14th", "kind": "clean", "version": 3, "note": "spec 3.8 sentence 3: 'the 14th' is a date, not a count", "texts": ["restock the lemons on the 14th"], "replies": [{"skill": "stock.restock", "slots": {"item": "photo-product-017", "day": "2026-11-14"}}], "expect": {"skill": "stock.restock", "disposition": "proposed", "ops": [{"op": "product.set_restock", "args": {"id": "photo-product-017", "restock_on": "2026-11-14"}}], "diff": [{"file": "hass/content/products.json", "path": "products[photo-product-017].restock_on", "after": "2026-11-14"}], "files": ["hass/content/products.json"], "preview": {"kind": "none"}, "reply_contains": "Lemons: more expected Sat Nov 14"}}
{"id": "s04-multi-honey-and-eggs", "kind": "multi", "version": 3, "note": "spec 3.8 sentence 4: two products in one message are two calls and one draft", "texts": ["honey and eggs both back Thursday"], "replies": [{"calls": [{"skill": "stock.restock", "slots": {"item": "photo-product-042", "day": "2026-11-12"}}, {"skill": "stock.restock", "slots": {"item": "photo-product-024", "day": "2026-11-12"}}]}], "expect": {"skill": "stock.restock", "disposition": "proposed", "ops": [{"op": "product.set_restock", "args": {"id": "photo-product-042", "restock_on": "2026-11-12"}}, {"op": "product.set_restock", "args": {"id": "photo-product-024", "restock_on": "2026-11-12"}}], "diff": [{"file": "hass/content/products.json", "path": "products[photo-product-024].restock_on", "after": "2026-11-12"}, {"file": "hass/content/products.json", "path": "products[photo-product-042].restock_on", "after": "2026-11-12"}], "files": ["hass/content/products.json"], "preview": {"kind": "none"}, "reply_contains": "Cal Poly eggs: more expected Thu Nov 12"}}
