{"id": "refuse-already-on-the-site", "kind": "refuse", "texts": ["Etto is back"], "replies": [{"skill": "maker.restore", "slots": {"maker": "Etto"}}], "version": 1, "expect": {"skill": "maker.restore", "disposition": "unsupported", "reply_contains": "Etto is already on the site"}}
{"id": "refuse-unknown-maker", "kind": "refuse", "texts": ["restore Acme"], "replies": [{"skill": "maker.restore", "slots": {"maker": "Acme"}}], "version": 1, "expect": {"skill": "maker.restore", "disposition": "unsupported", "reply_contains": "I don't know a maker called Acme"}}
{"id": "vague-asks-which-maker", "kind": "vague", "texts": ["bring back the pasta people"], "replies": [{"question": "Which maker do you mean?"}], "version": 1, "expect": {"disposition": "question", "question_contains": "Which maker"}}
{"id": "multi-both-already-there", "kind": "multi", "texts": ["Etto and Linn's are back"], "replies": [{"calls": [{"skill": "maker.restore", "slots": {"maker": "Etto"}}, {"skill": "maker.restore", "slots": {"maker": "Linn's"}}]}], "version": 1, "expect": {"skill": ["maker.restore"], "disposition": "unsupported", "reply_contains": "already on the site"}}
{"id": "typo-already-there", "kind": "typo", "texts": ["restor etto"], "replies": [{"skill": "maker.restore", "slots": {"maker": "Etto"}}], "version": 1, "expect": {"skill": "maker.restore", "disposition": "unsupported", "reply_contains": "already on the site"}}
{"id": "refuse-with-its-products", "kind": "refuse", "texts": ["restore Fair Hills and its products"], "replies": [{"skill": "maker.restore", "slots": {"maker": "Fair Hills"}}], "version": 1, "expect": {"skill": "maker.restore", "disposition": "unsupported", "reply_contains": "Fair Hills Farm is already on the site"}}
{"id": "plan-restore", "plan": true, "slots": {"maker": "Etto"}, "expect_ops": [{"op": "maker.restore", "args": {"key": "Etto"}}], "version": 1}
{"id": "plan-restore-a-name-with-an-apostrophe", "plan": true, "slots": {"maker": "Linn's"}, "expect_ops": [{"op": "maker.restore", "args": {"key": "Linn's"}}], "version": 1}
{"id": "plan-restore-needs-a-maker", "plan": true, "slots": {}, "expect_error": "Which maker", "version": 1}
{"id": "plan-restore-no-name-asks", "plan": true, "slots": {"maker": "  "}, "expect_error": "Which maker", "version": 1}
{"id": "restore-1-etto", "kind": "clean", "version": 1, "note": "apply then undo: a hidden maker comes back; their products are not touched and the reply says they stay hidden", "setup": [{"op": "maker.hide", "args": {"key": "Etto", "withProducts": true}}], "texts": ["Etto is back"], "replies": [{"skill": "maker.restore", "slots": {"maker": "Etto"}}], "undo": true, "expect": {"skill": "maker.restore", "disposition": "proposed", "ops": [{"op": "maker.restore", "args": {"key": "Etto"}}], "diff": [{"file": "hass/content/makers.json", "path": "makers.Etto.hidden", "before": true}], "files": ["hass/content/makers.json", "storefront-mockup/producers.js", "storefront-mockup/producers.json"], "preview": {"kind": "maker"}, "reply_contains": "Their products stay hidden until you bring them back"}}
{"id": "restore-2-big-sur-honey", "kind": "clean", "version": 1, "note": "apply then undo: a maker with one product", "setup": [{"op": "maker.hide", "args": {"key": "Big Sur Honey Company", "withProducts": true}}], "texts": ["we carry Big Sur Honey again"], "replies": [{"skill": "maker.restore", "slots": {"maker": "Big Sur Honey Company"}}], "undo": true, "expect": {"skill": "maker.restore", "disposition": "proposed", "ops": [{"op": "maker.restore", "args": {"key": "Big Sur Honey Company"}}], "diff": [{"file": "hass/content/makers.json", "path": "makers.Big Sur Honey Company.hidden", "before": true}], "files": ["hass/content/makers.json", "storefront-mockup/producers.js", "storefront-mockup/producers.json"], "preview": {"kind": "maker"}}}
{"id": "restore-3-typo-fair-hills", "kind": "typo", "version": 1, "note": "apply then undo: a typo and a short name still find the one hidden maker", "setup": [{"op": "maker.hide", "args": {"key": "Fair Hills Farm", "withProducts": true}}], "texts": ["restor fair hills"], "replies": [{"skill": "maker.restore", "slots": {"maker": "Fair Hills Farm"}}], "undo": true, "expect": {"skill": "maker.restore", "disposition": "proposed", "ops": [{"op": "maker.restore", "args": {"key": "Fair Hills Farm"}}], "diff": [{"file": "hass/content/makers.json", "path": "makers.Fair Hills Farm.hidden", "before": true}], "files": ["hass/content/makers.json", "storefront-mockup/producers.js", "storefront-mockup/producers.json"], "preview": {"kind": "maker"}}}
{"id": "restore-4-two-makers-one-draft", "kind": "multi", "version": 1, "note": "apply then undo: two makers, one draft, one undo", "setup": [{"op": "maker.hide", "args": {"key": "Etto", "withProducts": true}}, {"op": "maker.hide", "args": {"key": "Linn's", "withProducts": true}}], "texts": ["Etto and Linn's are back"], "replies": [{"calls": [{"skill": "maker.restore", "slots": {"maker": "Etto"}}, {"skill": "maker.restore", "slots": {"maker": "Linn's"}}]}], "undo": true, "expect": {"skill": "maker.restore", "disposition": "proposed", "ops": [{"op": "maker.restore", "args": {"key": "Etto"}}, {"op": "maker.restore", "args": {"key": "Linn's"}}], "diff": [{"file": "hass/content/makers.json", "path": "makers.Etto.hidden", "before": true}, {"file": "hass/content/makers.json", "path": "makers.Linn's.hidden", "before": true}], "files": ["hass/content/makers.json", "storefront-mockup/producers.js", "storefront-mockup/producers.json"], "preview": {"kind": "maker"}}}
{"id": "restore-5-turns-asks-which", "kind": "turns", "version": 1, "note": "apply then undo: no name asks which; the short answer goes on to one draft", "setup": [{"op": "maker.hide", "args": {"key": "Stepladder", "withProducts": true}}], "texts": ["bring back the cheese people", "Stepladder"], "replies": [{"question": "Which maker do you mean?"}, {"skill": "maker.restore", "slots": {"maker": "Stepladder"}}], "undo": true, "expect": {"skill": "maker.restore", "disposition": "proposed", "ops": [{"op": "maker.restore", "args": {"key": "Stepladder"}}], "diff": [{"file": "hass/content/makers.json", "path": "makers.Stepladder.hidden", "before": true}], "files": ["hass/content/makers.json", "storefront-mockup/producers.js", "storefront-mockup/producers.json"], "preview": {"kind": "maker"}, "dispositions": ["question", "proposed"]}}
