{"id": "clean-new-phone", "kind": "clean", "version": 1, "undo": true, "texts": ["our new number is 805-555-0100"], "replies": [{"skill": "shop.contact", "slots": {"phone": "805-555-0100"}}], "expect": {"skill": "shop.contact", "disposition": "proposed", "ops": [{"op": "store.set_phone", "args": {"phone": "8055550100"}}], "diff": [{"file": "hass/content/store.json", "path": "phone", "after": "8055550100"}], "files": ["hass/content/store.json", "storefront-mockup/index.html"], "preview": {"kind": "store"}}}
{"id": "typo-phone", "kind": "typo", "version": 1, "texts": ["chang the phoen to 805 555 0100"], "replies": [{"skill": "shop.contact", "slots": {"phone": "805 555 0100"}}], "expect": {"skill": "shop.contact", "disposition": "proposed", "ops": [{"op": "store.set_phone", "args": {"phone": "8055550100"}}], "diff": [{"file": "hass/content/store.json", "path": "phone", "after": "8055550100"}], "files": ["hass/content/store.json", "storefront-mockup/index.html"], "preview": {"kind": "store"}}}
{"id": "clean-moved", "kind": "clean", "version": 1, "texts": ["we moved: 1023 Example Street, Morro Bay"], "replies": [{"skill": "shop.contact", "slots": {"street_address": "1023 Example Street", "town": "Morro Bay"}}], "expect": {"skill": "shop.contact", "disposition": "proposed", "ops": [{"op": "store.set_address", "args": {"streetAddress": "1023 Example Street"}}], "diff": [{"file": "hass/content/store.json", "path": "streetAddress", "before": "2190 Main Street", "after": "1023 Example Street"}], "files": ["hass/content/store.json", "storefront-mockup/hike/index.html", "storefront-mockup/index.html"], "preview": {"kind": "store"}}}
{"id": "vague-address", "kind": "vague", "version": 1, "texts": ["update our address"], "replies": [{"question": "What is the street and the town?"}], "expect": {"disposition": "question", "question_contains": "street"}}
{"id": "multi-phone-and-street", "kind": "multi", "version": 1, "texts": ["new phone 805 555 0100 and new street 1023 Example Street"], "replies": [{"skill": "shop.contact", "slots": {"phone": "805 555 0100", "street_address": "1023 Example Street"}}], "expect": {"skill": "shop.contact", "disposition": "proposed", "ops": [{"op": "store.set_phone", "args": {"phone": "8055550100"}}, {"op": "store.set_address", "args": {"streetAddress": "1023 Example Street"}}], "diff": [{"file": "hass/content/store.json", "path": "phone", "after": "8055550100"}, {"file": "hass/content/store.json", "path": "streetAddress", "before": "2190 Main Street", "after": "1023 Example Street"}], "files": ["hass/content/store.json", "storefront-mockup/hike/index.html", "storefront-mockup/index.html"], "preview": {"kind": "store"}}}
{"id": "turns-the-number", "kind": "turns", "version": 1, "texts": ["change the phone number", "805 555 0100"], "replies": [{"question": "What is the number?"}, {"skill": "shop.contact", "slots": {"phone": "805 555 0100"}}], "expect": {"skill": "shop.contact", "dispositions": ["question", "proposed"], "ops": [{"op": "store.set_phone", "args": {"phone": "8055550100"}}], "diff": [{"file": "hass/content/store.json", "path": "phone", "after": "8055550100"}], "files": ["hass/content/store.json", "storefront-mockup/index.html"], "preview": {"kind": "store"}}}
{"id": "clean-town-only", "kind": "clean", "version": 1, "texts": ["just fix the town to Los Osos"], "replies": [{"skill": "shop.contact", "slots": {"town": "Los Osos"}}], "expect": {"skill": "shop.contact", "disposition": "proposed", "ops": [{"op": "store.set_address", "args": {"town": "Los Osos"}}], "diff": [{"file": "hass/content/store.json", "path": "town", "before": "Morro Bay", "after": "Los Osos"}], "files": ["hass/content/store.json", "storefront-mockup/hike/index.html", "storefront-mockup/index.html"], "preview": {"kind": "store"}}}
{"id": "refuse-not-ten-digits", "kind": "refuse", "version": 1, "texts": ["phone 555-0100"], "replies": [{"skill": "shop.contact", "slots": {"phone": "555-0100"}}], "expect": {"skill": "shop.contact", "disposition": "unsupported", "reply_contains": "area code"}}
{"id": "refuse-not-a-real-number", "kind": "refuse", "version": 1, "texts": ["the number is 123-456-7890"], "replies": [{"skill": "shop.contact", "slots": {"phone": "123-456-7890"}}], "expect": {"skill": "shop.contact", "disposition": "unsupported", "reply_contains": "real US phone number"}}
{"id": "refuse-no-phone-to-remove", "kind": "refuse", "version": 1, "texts": ["take the phone number off the site"], "replies": [{"skill": "shop.contact", "slots": {"clear": true}}], "expect": {"skill": "shop.contact", "disposition": "unsupported", "reply_contains": "nothing to take off"}}
{"id": "plan-take-the-phone-off", "plan": true, "skill": "shop.contact", "version": 1, "slots": {"clear": true}, "ctx": {"store": {"hours": ["Monday–Friday 9am–6pm", "Saturday 9am–5pm · Closed Sunday"], "phone": "8055550100", "streetAddress": "2190 Main Street", "town": "Morro Bay"}}, "expect_ops": [{"op": "store.clear_phone", "args": {}}]}
{"id": "plan-leading-one-is-dropped", "plan": true, "skill": "shop.contact", "version": 1, "slots": {"phone": "+1 (805) 555-0123"}, "expect_ops": [{"op": "store.set_phone", "args": {"phone": "8055550123"}}]}
{"id": "plan-phone-already-there", "plan": true, "skill": "shop.contact", "version": 1, "slots": {"phone": "805-555-0100"}, "ctx": {"store": {"hours": ["Monday–Friday 9am–6pm", "Saturday 9am–5pm · Closed Sunday"], "phone": "8055550100", "streetAddress": "2190 Main Street", "town": "Morro Bay"}}, "expect_error": "It already says that: the phone is 805 555 0100"}
{"id": "plan-address-already-there", "plan": true, "skill": "shop.contact", "version": 1, "slots": {"street_address": "2190  Main Street", "town": "Morro Bay"}, "ctx": {"store": {"hours": ["Monday–Friday 9am–6pm", "Saturday 9am–5pm · Closed Sunday"], "phone": "8055550100", "streetAddress": "2190 Main Street", "town": "Morro Bay"}}, "expect_error": "It already says that: the address is 2190 Main Street, Morro Bay"}
{"id": "plan-new-phone-and-old-town-still-drafts", "plan": true, "skill": "shop.contact", "version": 1, "slots": {"phone": "805 555 0123", "town": "Morro Bay"}, "ctx": {"store": {"hours": ["Monday–Friday 9am–6pm", "Saturday 9am–5pm · Closed Sunday"], "phone": "8055550100", "streetAddress": "2190 Main Street", "town": "Morro Bay"}}, "expect_ops": [{"op": "store.set_phone", "args": {"phone": "8055550123"}}]}
{"id": "plan-phone-and-take-it-off", "plan": true, "skill": "shop.contact", "version": 1, "slots": {"phone": "805 555 0123", "clear": true}, "expect_error": "only do one"}
{"id": "plan-nothing-given-asks", "plan": true, "skill": "shop.contact", "version": 1, "slots": {}, "expect_error": "What is the new phone number, or the new street and town?"}
{"id": "plan-street-too-long", "plan": true, "skill": "shop.contact", "version": 1, "slots": {"street_address": "xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"}, "expect_error": "too long"}
{"id": "plan-town-without-letters", "plan": true, "skill": "shop.contact", "version": 1, "slots": {"town": "12345"}, "expect_error": "some letters"}
{"id": "plan-eleven-digits-not-starting-with-one", "plan": true, "skill": "shop.contact", "version": 1, "slots": {"phone": "28055550100"}, "expect_error": "area code"}
