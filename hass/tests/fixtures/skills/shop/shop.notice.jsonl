{"id": "multi-notice-and-hours", "kind": "multi", "version": 2, "texts": ["notice: closed Thursday. also hours Friday 10 to 4"], "replies": [{"calls": [{"skill": "shop.notice", "slots": {"text": "Closed Thursday", "until": "2026-11-12"}}, {"skill": "shop.hours", "slots": {"hours": ["Monday–Thursday 9am–6pm", "Friday 10am–4pm", "Saturday 9am–5pm · Closed Sunday"]}}]}], "expect": {"skill": ["shop.hours", "shop.notice"], "disposition": "proposed", "ops": [{"op": "store.set_notice", "args": {"text": "Closed Thursday", "until": "2026-11-12"}}, {"op": "store.set_hours", "args": {"hours": ["Monday–Thursday 9am–6pm", "Friday 10am–4pm", "Saturday 9am–5pm · Closed Sunday"]}}], "diff": [{"file": "hass/content/store.json", "path": "hours", "before": ["Monday–Friday 9am–6pm", "Saturday 9am–5pm · Closed Sunday"], "after": ["Monday–Thursday 9am–6pm", "Friday 10am–4pm", "Saturday 9am–5pm · Closed Sunday"]}, {"file": "hass/content/store.json", "path": "notice", "after": {"from": "2026-11-08", "text": "Closed Thursday", "until": "2026-11-12"}}], "files": ["hass/content/store.json", "storefront-mockup/index.html"], "preview": {"kind": "store"}}}
