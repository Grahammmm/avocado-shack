{"id": "clean-thanksgiving", "kind": "clean", "version": 2, "undo": true, "texts": ["put a notice up: we're closed Thanksgiving, back Friday"], "replies": [{"skill": "shop.notice", "slots": {"text": "We're closed Thanksgiving, back Friday", "until": "2026-11-26"}}], "expect": {"skill": "shop.notice", "disposition": "proposed", "ops": [{"op": "store.set_notice", "args": {"text": "We're closed Thanksgiving, back Friday", "until": "2026-11-26"}}], "diff": [{"file": "hass/content/store.json", "path": "notice", "after": {"from": "2026-11-08", "text": "We're closed Thanksgiving, back Friday", "until": "2026-11-26"}}], "files": ["hass/content/store.json", "storefront-mockup/index.html"], "preview": {"kind": "store"}}}
