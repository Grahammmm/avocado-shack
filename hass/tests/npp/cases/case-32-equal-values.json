  "terminal": "published",
  "settings": {
    "npp": true,
    "houseRender": true,
    "photo_polish": true,
    "itemIntake": true,
    "liveSite": true,
    "approvalTtlSeconds": 7200
  },
  "variants": [
    {
      "id": "a",
      "title": "digits",
      "turns": [
        {
          "at_s": 0,
          "from": "mike",
          "text": "ridge roast dark coffee, cost 14, selling 14 each, got 12 bags",
          "photos": [
            "npp:coffee.jpg"
          ]
        },
        {
          "at_s": 60,
          "from": "mike",
          "text": "yes {code}-1",
          "photos": []
        }
      ]
    },
    {
      "id": "b",
      "title": "spoken",
      "turns": [
        {
          "at_s": 0,
          "from": "mike",
          "text": "ridge roast dark coffee, cost fourteen, selling fourteen each, got twelve bags",
          "photos": [
            "npp:coffee.jpg"
          ]
        },
        {
          "at_s": 60,
          "from": "mike",
          "text": "yes {code}-1",
          "photos": []
