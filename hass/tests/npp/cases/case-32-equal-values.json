      "cost": "14",
      "quantity": "12"
    }
  },
  "expect": {
    "state": "published",
    "listing": {
      "price": "$14.00",
      "label_size_kept": "12 oz"
    },
    "private_in_public": "none",
    "same_result_for_spoken_and_digit_forms": true,
    "commits": 1,
    "cloud_bodies_lack_digits_from": [
