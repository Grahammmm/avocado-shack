# Optional real Stripe test mode. Supply secrets locally, never in chat or source.
PAYMENT_MODE=simulator
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Project database/auth secrets are generated into ignored .runtime/config.json.
# Website and backend are bound to 127.0.0.1. No public hosting enabled.
NEXT_TELEMETRY_DISABLED=1
MEDUSA_DISABLE_TELEMETRY=true
